# Copia este archivo a .env (cp .env.example .env). NUNCA subas .env a git.

# --- Base de datos ---
DB_HOST=db
DB_PORT=3306
DB_NAME=antojito_db
DB_USER=root
DB_PASSWORD=antojito_root_dev
MYSQL_ROOT_PASSWORD=antojito_root_dev

# --- Flask ---
# Puerto de la app en tu máquina. Cámbialo si el 5000 ya está ocupado (por ejemplo WEB_PORT=5001)
WEB_PORT=5000
SECRET_KEY=cambia-esto-por-un-valor-largo-y-aleatorio
# Pon true solo cuando se sirva por HTTPS
COOKIE_SECURE=false

# --- Gemini (la clave se obtiene en https://aistudio.google.com/apikey; nunca la subas) ---
GEMINI_API_KEY=
# Voz (Live API)
GEMINI_MODEL=gemini-3.8-live
# Respaldos de voz, en orden, si el modelo principal está saturado o no disponible
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash-native-audio-latest,gemini-3.1-flash-live-preview
# Chat de texto (respaldo del asistente de voz)
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-3.8-flash

# --- AWS (opcional) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# --- Pruebas locales ---
# true guarda las contraseñas de cuentas NUEVAS sin hash (prefijo "plano:"), para depurar en local.
# Nunca en producción ni con el túnel abierto. Ver utils/contrasenas.py.
CONTRASENAS_SIN_HASH=false
