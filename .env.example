# Copia este archivo a .env (cp .env.example .env). NUNCA subas .env a git.

# --- Base de datos ---
DB_HOST=db
DB_PORT=3306
DB_NAME=antojito_db
DB_USER=root
DB_PASSWORD=antojito_root_dev
MYSQL_ROOT_PASSWORD=antojito_root_dev

# --- Flask ---
SECRET_KEY=cambia-esto-por-un-valor-largo-y-aleatorio
# Pon true solo cuando se sirva por HTTPS
COOKIE_SECURE=false

# --- Gemini Live (pendiente: conseguir clave y modelo) ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- AWS (opcional) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
